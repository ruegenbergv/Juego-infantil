<!-- index.html -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>¡Aprendo a Contar!</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <div class="app">

    <!-- PANTALLA DE INICIO -->
    <section id="start-screen" class="screen">
      <div class="floating-icons">🐰🦋🐥🍓</div>
      <h1>¡Aprendo a Contar!</h1>
      <p class="subtitle">Toca el número correcto 🎈</p>
      <button id="start-btn" class="big-btn">▶️ Empezar</button>
    </section>

    <!-- PANTALLA DE JUEGO -->
    <section id="game-screen" class="screen hidden">
      <button id="home-btn" class="home-btn" title="Volver al inicio">🏠</button>

      <h2 class="question">¿Cuántos hay?</h2>

      <div id="objects-container" class="objects-container"></div>

      <div id="numbers-container" class="numbers-container"></div>

      <button id="check-btn" class="big-btn check-btn hidden">✅ Comprobar</button>

      <p id="feedback-msg" class="feedback-msg"></p>
    </section>

    <!-- CELEBRACIÓN -->
    <section id="celebration-screen" class="screen hidden celebration">
      <div id="animals-container" class="animals-container"></div>
      <h1 class="celebration-title">¡Muy bien! 🎉</h1>
      <button id="again-btn" class="big-btn">🔄 Otra vez</button>
    </section>

  </div>

  <script src="app.js"></script>
</body>
</html>
